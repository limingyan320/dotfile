// Ubuntu preset with an external raw logo rendered from a Sharingan-inspired eye asset.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "general": {
        "detectVersion": false
    },
    "display": {
        "separator": "◢ ",
        "key": {
            "width": 14
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#196}{user-name-colored}{#208}@{host-name-colored} {#220}// {#208}SHARINGAN"
        },
        {
            "type": "custom",
            "format": "{#166}three tomoe engaged // ubuntu node"
        },
        "separator",
        {
            "type": "os",
            "key": "{#196}DISTRO       "
        },
        {
            "type": "host",
            "key": "{#196}HOST         "
        },
        {
            "type": "kernel",
            "key": "{#196}KERNEL       "
        },
        {
            "type": "uptime",
            "key": "{#196}UPTIME       "
        },
        {
            "type": "packages",
            "key": "{#196}PACKAGES     "
        },
        {
            "type": "shell",
            "key": "{#196}SHELL        "
        },
        {
            "type": "terminal",
            "key": "{#196}TERMINAL     "
        },
        {
            "type": "cpu",
            "key": "{#196}CPU          "
        },
        {
            "type": "gpu",
            "key": "{#196}GPU          "
        },
        {
            "type": "memory",
            "key": "{#196}CHAKRA       ",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "{#196}STORAGE      ",
            "format": "{size-used} / {size-total}"
        },
        {
            "type": "localip",
            "key": "{#196}LINK         ",
            "format": "{ipv4}"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
