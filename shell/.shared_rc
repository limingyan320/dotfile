# ============================================
# .shared_rc — 跨平台通用配置
# macOS (.zshrc) 和 Linux (.bashrc) 都会 source 这个文件
# ============================================

# --- 环境变量 ---
export LANG=en_US.UTF-8
export EDITOR=nvim
export DISABLE_TELEMETRY=1

# --- PATH ---
# 在这里添加跨平台通用的 PATH
# export PATH="$HOME/.local/bin:$PATH"

# --- 通用别名 ---
if [[ $- == *i* ]]; then
    alias vim='nvim'
    alias ll='ls -la'
    alias la='ls -a'
    alias ..='cd ..'
    alias ...='cd ../..'
    alias claude='claude --dangerously-skip-permissions'
    alias codex='codex --yolo'
    alias g='nvitop'
    alias v5='ssh -N -D 192.168.100.160:1080 administrator@192.168.100.127'

    __dotfiles_fastfetch_default_profile() {
        local system
        system="$(uname -s 2>/dev/null)"

        if [ "$system" = "Darwin" ]; then
            printf '%s\n' "macos-rei31"
            return 0
        elif [ "$system" = "Linux" ] && [ -r /etc/os-release ]; then
            local os_id
            os_id="$(
                . /etc/os-release
                printf '%s' "${ID:-}"
            )"

            if [ "$os_id" = "ubuntu" ]; then
                printf '%s\n' "ubuntu-sharingan"
                return 0
            fi
        fi

        printf '%s\n' "plain"
    }

    __dotfiles_fastfetch_profile() {
        if [ -n "${DOTFILES_FASTFETCH_PROFILE:-}" ]; then
            printf '%s\n' "$DOTFILES_FASTFETCH_PROFILE"
            return 0
        fi

        __dotfiles_fastfetch_default_profile
    }

    __dotfiles_fastfetch_run() {
        local profile preset logo

        if [ -n "${DOTFILES_FASTFETCH_CONFIG:-}" ] && [ -f "${DOTFILES_FASTFETCH_CONFIG:-}" ]; then
            if [ -n "${DOTFILES_FASTFETCH_LOGO:-}" ] && [ -f "${DOTFILES_FASTFETCH_LOGO:-}" ]; then
                command fastfetch \
                    --config "$DOTFILES_FASTFETCH_CONFIG" \
                    --logo-type "${DOTFILES_FASTFETCH_LOGO_TYPE:-file-raw}" \
                    --logo "$DOTFILES_FASTFETCH_LOGO" \
                    --logo-padding-right "${DOTFILES_FASTFETCH_LOGO_PADDING_RIGHT:-2}" \
                    "$@"
                return
            fi

            command fastfetch --config "$DOTFILES_FASTFETCH_CONFIG" "$@"
            return
        fi

        profile="$(__dotfiles_fastfetch_profile)"

        case "$profile" in
            macos-rei|macos-rei31|rei|rei31)
                preset="$HOME/.config/fastfetch/presets/macos-rei31.jsonc"
                if [ -f "$preset" ]; then
                    command fastfetch --config "$preset" "$@"
                    return
                fi
                ;;
            ubuntu-sharingan|ubuntu|sharingan)
                preset="$HOME/.config/fastfetch/presets/ubuntu-sharingan.jsonc"
                logo="$HOME/.config/fastfetch/logos/ubuntu_sharingan_eye.ffraw.txt"
                if [ -f "$preset" ] && [ -f "$logo" ]; then
                    command fastfetch --config "$preset" --logo-type file-raw --logo "$logo" --logo-padding-right 2 "$@"
                    return
                fi
                ;;
            obito-kamui|obito|kamui|ubuntu-obito)
                preset="$HOME/.config/fastfetch/presets/ubuntu-obito-kamui.jsonc"
                logo="$HOME/.config/fastfetch/logos/ubuntu_obito_kamui_eye.ffraw.txt"
                if [ -f "$preset" ] && [ -f "$logo" ]; then
                    command fastfetch --config "$preset" --logo-type file-raw --logo "$logo" --logo-padding-right 3 "$@"
                    return
                fi
                ;;
            finger|ss-finger|middle-finger)
                logo="$HOME/.config/fastfetch/logos/ss_finger.ffraw.txt"
                if [ -f "$logo" ]; then
                    command fastfetch --logo-type file-raw --logo "$logo" --logo-padding-right 2 "$@"
                    return
                fi
                ;;
            plain|default|none)
                ;;
            *)
                if [ -f "$profile" ]; then
                    command fastfetch --config "$profile" "$@"
                    return
                fi
                ;;
        esac

        command fastfetch "$@"
    }

    ff() {
        __dotfiles_fastfetch_run "$@"
    }

    fffinger() {
        DOTFILES_FASTFETCH_PROFILE="finger" __dotfiles_fastfetch_run "$@"
    }

    ffobito() {
        DOTFILES_FASTFETCH_PROFILE="obito-kamui" __dotfiles_fastfetch_run "$@"
    }

    ffprofiles() {
        printf '%s\n' "macos-rei31" "ubuntu-sharingan" "obito-kamui" "finger" "plain"
    }
fi

# --- 加载机器本地的秘密配置（API key 等，不进 git）---
[ -f "$HOME/.secrets" ] && source "$HOME/.secrets"

if [ -d "$HOME/.local/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) PATH="$HOME/.local/bin:$PATH" ;;
    esac
fi

# --- Node / npm 全局可执行文件 ---
# 某些机器通过 nvm 安装 codex，实际二进制在 ~/.nvm/versions/node/*/bin 下。
if [ -d "$HOME/.nvm/versions/node" ]; then
    for __dotfiles_node_bin in "$HOME"/.nvm/versions/node/*/bin; do
        [ -d "$__dotfiles_node_bin" ] || continue
        case ":$PATH:" in
            *":$__dotfiles_node_bin:"*) ;;
            *) PATH="$__dotfiles_node_bin:$PATH" ;;
        esac
    done
    unset __dotfiles_node_bin
fi

export PATH
export CODEX_NOTIFY_LISTEN_PORT="${CODEX_NOTIFY_LISTEN_PORT:-47789}"

# --- Codex 通知配置自愈 ---
__dotfiles_has_real_command() {
    if [ -n "${ZSH_VERSION:-}" ]; then
        whence -p "$1" >/dev/null 2>&1
    else
        type -P "$1" >/dev/null 2>&1
    fi
}

__dotfiles_repo_root() {
    if [ -n "${__DOTFILES_REPO_ROOT:-}" ] && [ -d "${__DOTFILES_REPO_ROOT:-}" ]; then
        printf '%s\n' "$__DOTFILES_REPO_ROOT"
        return 0
    fi

    __dotfiles_has_real_command python3 || return 1

    local resolved
    resolved="$(python3 - "$HOME/.shared_rc" <<'PY'
import os
import sys

print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))
PY
)" || return 1

    [ -n "$resolved" ] && [ -d "$resolved" ] || return 1
    __DOTFILES_REPO_ROOT="$resolved"
    export __DOTFILES_REPO_ROOT
    printf '%s\n' "$__DOTFILES_REPO_ROOT"
}

__dotfiles_stat_mtime() {
    [ -e "$1" ] || return 1
    if stat -f '%m' "$1" >/dev/null 2>&1; then
        stat -f '%m' "$1"
    else
        stat -c '%Y' "$1"
    fi
}

__dotfiles_codex_notify_config_ok() {
    local repo_root="$1"
    local config_path="$HOME/.codex/config.toml"
    local notify_script="$repo_root/codex-notifications/notify.py"
    local expected_notify="notify = [\"python3\", \"$notify_script\"]"
    local expected_events='notifications = ["agent-turn-complete", "approval-requested"]'

    [ -f "$config_path" ] || return 1
    __dotfiles_has_real_command python3 || {
        grep -Fqx "$expected_notify" "$config_path" && grep -Fqx "$expected_events" "$config_path"
        return $?
    }

    if python3 - <<'PY' >/dev/null 2>&1
import tomllib
PY
    then
        python3 - "$config_path" "$notify_script" <<'PY' >/dev/null 2>&1
import sys
import tomllib

config_path, notify_script = sys.argv[1], sys.argv[2]
with open(config_path, "rb") as f:
    data = tomllib.loads(f.read().decode("utf-8"))

if not isinstance(data, dict):
    raise SystemExit(1)

if data.get("notify") != ["python3", notify_script]:
    raise SystemExit(1)

tui = data.get("tui")
if not isinstance(tui, dict):
    raise SystemExit(1)

if tui.get("notifications") != ["agent-turn-complete", "approval-requested"]:
    raise SystemExit(1)
PY
        return $?
    fi

    grep -Fqx "$expected_notify" "$config_path" && grep -Fqx "$expected_events" "$config_path"
}

__dotfiles_codex_ensure_listener() {
    [ "$(uname -s 2>/dev/null)" = "Darwin" ] || return 0
    [ -z "${SSH_CONNECTION:-}" ] || return 0
    [ "${__DOTFILES_CODEX_LISTENER_ENSURED:-0}" = "1" ] && return 0

    local repo_root="$1"
    local install_script="$repo_root/codex-notifications/install-listener.sh"
    local plist_path="$HOME/Library/LaunchAgents/com.lumynous.codex-notify-listener.plist"

    if [ ! -f "$plist_path" ] || ! launchctl list 2>/dev/null | grep -q 'com\.lumynous\.codex-notify-listener'; then
        [ -f "$install_script" ] && bash "$install_script" >/dev/null 2>&1 || true
    fi

    __DOTFILES_CODEX_LISTENER_ENSURED=1
    export __DOTFILES_CODEX_LISTENER_ENSURED
}

__dotfiles_codex_notify_self_heal() {
    [ -n "${__DOTFILES_CODEX_NOTIFY_HEALING:-}" ] && return 0

    __dotfiles_has_real_command codex || return 0

    local repo_root
    repo_root="$(__dotfiles_repo_root)" || return 0

    local apply_script="$repo_root/codex-notifications/apply.sh"
    local config_path="$HOME/.codex/config.toml"
    local current_mtime="missing"
    local now_epoch

    [ -f "$apply_script" ] || return 0

    if current_mtime="$(__dotfiles_stat_mtime "$config_path" 2>/dev/null)"; then
        :
    else
        current_mtime="missing"
    fi

    if [ "${__DOTFILES_CODEX_NOTIFY_LAST_OK:-0}" = "1" ] && [ "${__DOTFILES_CODEX_NOTIFY_LAST_MTIME:-}" = "$current_mtime" ]; then
        __dotfiles_codex_ensure_listener "$repo_root"
        return 0
    fi

    now_epoch="$(date +%s 2>/dev/null)"
    if [ "${__DOTFILES_CODEX_NOTIFY_LAST_OK:-0}" != "1" ] \
        && [ "${__DOTFILES_CODEX_NOTIFY_LAST_MTIME:-}" = "$current_mtime" ] \
        && [ -n "${__DOTFILES_CODEX_NOTIFY_LAST_ATTEMPT_EPOCH:-}" ] \
        && [ -n "$now_epoch" ] \
        && [ $((now_epoch - __DOTFILES_CODEX_NOTIFY_LAST_ATTEMPT_EPOCH)) -lt 60 ]; then
        __dotfiles_codex_ensure_listener "$repo_root"
        return 0
    fi

    __DOTFILES_CODEX_NOTIFY_HEALING=1
    __DOTFILES_CODEX_NOTIFY_LAST_ATTEMPT_EPOCH="$now_epoch"
    export __DOTFILES_CODEX_NOTIFY_HEALING
    export __DOTFILES_CODEX_NOTIFY_LAST_ATTEMPT_EPOCH

    if ! __dotfiles_codex_notify_config_ok "$repo_root"; then
        bash "$apply_script" >/dev/null 2>&1 || true
    fi

    __dotfiles_codex_ensure_listener "$repo_root"

    if __dotfiles_codex_notify_config_ok "$repo_root"; then
        __DOTFILES_CODEX_NOTIFY_LAST_OK=1
    else
        __DOTFILES_CODEX_NOTIFY_LAST_OK=0
    fi

    if current_mtime="$(__dotfiles_stat_mtime "$config_path" 2>/dev/null)"; then
        :
    else
        current_mtime="missing"
    fi
    __DOTFILES_CODEX_NOTIFY_LAST_MTIME="$current_mtime"
    export __DOTFILES_CODEX_NOTIFY_LAST_OK
    export __DOTFILES_CODEX_NOTIFY_LAST_MTIME
    unset __DOTFILES_CODEX_NOTIFY_HEALING
}

# --- tmux pane 上下文同步 ---
# 让 tmux 新建 pane/window 时既能继承本地路径，也能在 ssh 场景下复用远端 host + cwd。
if [[ $- == *i* ]]; then
    [ -f "$HOME/.tmux-context.sh" ] && source "$HOME/.tmux-context.sh"
fi

# --- fastfetch：新开交互式终端时展示系统信息 ---
# 只在交互式 shell 且不在 tmux 内部时运行（避免每个 pane 都刷一屏）
if [[ $- == *i* ]] && [ -z "$TMUX" ] && command -v fastfetch &>/dev/null; then
    ff
fi

# --- Starship prompt ---
# 必须放在文件末尾，让 Starship 作为最后设置 PROMPT 的人
if [[ $- == *i* ]] && command -v starship &>/dev/null; then
    eval "$(starship init $(basename $SHELL))"
fi

if [[ $- == *i* ]] && [ -z "${__DOTFILES_CODEX_NOTIFY_HOOKS:-}" ]; then
    __DOTFILES_CODEX_NOTIFY_HOOKS=1
    export __DOTFILES_CODEX_NOTIFY_HOOKS
    if [ -n "${ZSH_VERSION:-}" ]; then
        autoload -Uz add-zsh-hook
        add-zsh-hook precmd __dotfiles_codex_notify_self_heal
    elif [ -n "${BASH_VERSION:-}" ]; then
        if [ -n "${PROMPT_COMMAND:-}" ]; then
            PROMPT_COMMAND="__dotfiles_codex_notify_self_heal; ${PROMPT_COMMAND}"
        else
            PROMPT_COMMAND="__dotfiles_codex_notify_self_heal"
        fi
    fi
    __dotfiles_codex_notify_self_heal
fi

if [[ $- == *i* ]] && [ -z "${__DOTFILES_TMUX_HOOKS:-}" ] && typeset -f __dotfiles_tmux_sync_context >/dev/null 2>&1 && typeset -f __dotfiles_tmux_context_enabled >/dev/null 2>&1 && __dotfiles_tmux_context_enabled; then
    __DOTFILES_TMUX_HOOKS=1
    if [ -n "${ZSH_VERSION:-}" ]; then
        autoload -Uz add-zsh-hook
        add-zsh-hook precmd __dotfiles_tmux_sync_context
    elif [ -n "${BASH_VERSION:-}" ]; then
        if [ -n "${PROMPT_COMMAND:-}" ]; then
            PROMPT_COMMAND="__dotfiles_tmux_sync_context; ${PROMPT_COMMAND}"
        else
            PROMPT_COMMAND="__dotfiles_tmux_sync_context"
        fi
    fi
    __dotfiles_tmux_sync_context
fi

if [[ $- == *i* ]] && [ "$(uname -s 2>/dev/null)" = "Darwin" ] && [ -z "${SSH_CONNECTION:-}" ]; then
    __dotfiles_codex_ssh_should_forward_notify() {
        [ -n "${DARWIN_NO_REMOTE_NOTIFY:-}" ] && return 1
        command -v ssh >/dev/null 2>&1 || return 1
        return 0
    }

    ssh() {
        if __dotfiles_codex_ssh_should_forward_notify; then
            local forward_spec="127.0.0.1:${CODEX_NOTIFY_LISTEN_PORT}:127.0.0.1:${CODEX_NOTIFY_LISTEN_PORT}"
            local arg
            for arg in "$@"; do
                [ "$arg" = "$forward_spec" ] && command ssh "$@" && return $?
                [ "$arg" = "-R" ] && command ssh "$@" && return $?
            done
            command ssh -R "$forward_spec" "$@"
        else
            command ssh "$@"
        fi
    }
fi
