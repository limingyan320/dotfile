# ============================================
# .shared_rc — 跨平台通用配置
# macOS (.zshrc) 和 Linux (.bashrc) 都会 source 这个文件
# ============================================

# --- 环境变量 ---
export LANG=en_US.UTF-8
export EDITOR=nvim

# --- PATH ---
# 在这里添加跨平台通用的 PATH
# export PATH="$HOME/.local/bin:$PATH"

# --- 通用别名 ---
alias vim='nvim'
alias ll='ls -la'
alias la='ls -a'
alias ..='cd ..'
alias ...='cd ../..'
alias claude='claude --dangerously-skip-permissions'
alias codex='codex --yolo'

# --- 加载机器本地的秘密配置（API key 等，不进 git）---
[ -f "$HOME/.secrets" ] && source "$HOME/.secrets"

export PATH="$HOME/.local/bin:$PATH"

# --- tmux pane 上下文同步 ---
# 让 tmux 新建 pane/window 时既能继承本地路径，也能在 ssh 场景下复用远端 host + cwd。
[ -f "$HOME/.tmux-context.sh" ] && source "$HOME/.tmux-context.sh"

# --- fastfetch：新开交互式终端时展示系统信息 ---
# 只在交互式 shell 且不在 tmux 内部时运行（避免每个 pane 都刷一屏）
if [[ $- == *i* ]] && [ -z "$TMUX" ] && command -v fastfetch &>/dev/null; then
    fastfetch
fi

# --- Starship prompt ---
# 必须放在文件末尾，让 Starship 作为最后设置 PROMPT 的人
if command -v starship &>/dev/null; then
    eval "$(starship init $(basename $SHELL))"
fi

if [[ $- == *i* ]] && [ -z "${__DOTFILES_TMUX_HOOKS:-}" ] && typeset -f __dotfiles_tmux_sync_context >/dev/null 2>&1 && typeset -f __dotfiles_tmux_context_enabled >/dev/null 2>&1 && __dotfiles_tmux_context_enabled; then
    __DOTFILES_TMUX_HOOKS=1
    if [ -n "${ZSH_VERSION:-}" ]; then
        autoload -Uz add-zsh-hook
        add-zsh-hook precmd __dotfiles_tmux_sync_context
    elif [ -n "${BASH_VERSION:-}" ]; then
        if [ -n "${PROMPT_COMMAND:-}" ]; then
            PROMPT_COMMAND="__dotfiles_tmux_sync_context; ${PROMPT_COMMAND}"
        else
            PROMPT_COMMAND="__dotfiles_tmux_sync_context"
        fi
    fi
    __dotfiles_tmux_sync_context
fi
