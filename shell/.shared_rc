# ============================================
# .shared_rc — 跨平台通用配置
# macOS (.zshrc) 和 Linux (.bashrc) 都会 source 这个文件
# ============================================

# --- 环境变量 ---
export LANG=en_US.UTF-8
export EDITOR=nvim

# --- PATH ---
# 在这里添加跨平台通用的 PATH
# export PATH="$HOME/.local/bin:$PATH"

# --- 通用别名 ---
alias vim='nvim'
alias ll='ls -la'
alias la='ls -a'
alias ..='cd ..'
alias ...='cd ../..'
alias claude='claude --dangerously-skip-permissions'

# --- 加载机器本地的秘密配置（API key 等，不进 git）---
[ -f "$HOME/.secrets" ] && source "$HOME/.secrets"

export PATH="$HOME/.local/bin:$PATH"

# --- fastfetch：新开交互式终端时展示系统信息 ---
# 只在交互式 shell 且不在 tmux 内部时运行（避免每个 pane 都刷一屏）
if [[ $- == *i* ]] && [ -z "$TMUX" ] && command -v fastfetch &>/dev/null; then
    fastfetch
fi

# --- Starship prompt ---
# 必须放在文件末尾，让 Starship 作为最后设置 PROMPT 的人
if command -v starship &>/dev/null; then
    eval "$(starship init $(basename $SHELL))"
fi
