#!/bin/sh
set -eu

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  printf '%s\n' "usage: contact-owner <code> <summary> [detail]" >&2
  exit 2
fi

event_dir="${ISOLATED_CODEX_CONTROL:-/codex-control}/blocked"
mkdir -p "$event_dir"
printf '%s' "$1" > "$event_dir/code"
printf '%s' "$2" > "$event_dir/summary"
printf '%s' "${3:-}" > "$event_dir/detail"
printf '%s' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true)" > "$event_dir/container_time"
printf '%s' ready > "$event_dir/ready.tmp"
mv "$event_dir/ready.tmp" "$event_dir/ready"
printf 'Blocked: %s: %s\n' "$1" "$2" >&2
exit 86
